{
  "name": "finanzas-en-pareja",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-web-export.cjs",
    "typecheck": "tsc --noEmit",
    "test:parser": "node --experimental-strip-types src/bank/bmscParser.test.ts",
    "test:supabase": "node --experimental-strip-types src/lib/supabase.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "^57.0.19",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-notifications": "^57.0.16",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
